diff --git a/configs/experiment_config/inference_gam030_des.yaml b/configs/experiment_config/inference_gam030_des.yaml
new file mode 100644
index 0000000..feb2a9e
--- /dev/null
+++ b/configs/experiment_config/inference_gam030_des.yaml
@@ -0,0 +1,13 @@
+# Table-1 M_FS row at gamma = 0.30 (sc_scale_noise). Designability path.
+# inference_base's grid: 5 lengths x 100 = 500 samples, which reproduced 94.0% at gamma=0.45
+# against the paper's 96.4%.
+defaults:
+  - inference_ucond_200m_tri
+  - _self_
+
+run_name_: gam030_des
+compute_designability: True
+compute_fid: False
+sampling_caflow:
+  sampling_mode: sc
+  sc_scale_noise: 0.30
diff --git a/configs/experiment_config/inference_gam030_fid.yaml b/configs/experiment_config/inference_gam030_fid.yaml
new file mode 100644
index 0000000..728975d
--- /dev/null
+++ b/configs/experiment_config/inference_gam030_fid.yaml
@@ -0,0 +1,13 @@
+# Table-1 M_FS row at gamma = 0.30 (sc_scale_noise). FID path.
+# Same length grid as inference_fid_ca (60:255:5, 40 lengths) so FPSD stays length-comparable,
+# but 25 samples/length = 1000 total instead of 5000: FID is biased at small N, so absolute
+# values sit above the paper's. The gamma-to-gamma gradient at fixed N is the quantity of interest.
+defaults:
+  - inference_fid_ca
+  - _self_
+
+run_name_: gam030_fid
+nsamples_per_len: 25
+sampling_caflow:
+  sampling_mode: sc
+  sc_scale_noise: 0.30
